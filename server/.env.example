MONGO_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Required only when AI_GENERATION_PROVIDER=gemini or
# AI_EMBEDDING_PROVIDER=gemini. A missing/placeholder value produces
# a startup warning rather than terminating mock/fallback operation.
GEMINI_API_KEY=your-gemini-api-key-here

# Legacy compatibility during the Phase 11 migration.
MOCK_AI=true

# ChromaDB connection defaults. These are not hard startup requirements.
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# AI providers default to mock generation and no retrieval if omitted.
AI_GENERATION_PROVIDER=mock
AI_EMBEDDING_PROVIDER=none

# Ollama settings are only used when an Ollama provider is selected.
# For Docker Desktop on Windows/macOS, use host.docker.internal.
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=700

# 768 for Ollama/nomic-embed-text; 3072 for Gemini/gemini-embedding-2.
# Changing embedding provider requires knowledge-base re-ingestion.
SENTINEL_EMBEDDING_DIM=768
