MONGO_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your-gemini-api-key-here

# Legacy compatibility during the Phase 11 migration.
MOCK_AI=true

CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---------------------------------------------------------------------------
# Mode 1 — Mock/recruiter mode (default, no AI runtime or API key required)
# ---------------------------------------------------------------------------
AI_GENERATION_PROVIDER=mock
AI_EMBEDDING_PROVIDER=none

# ---------------------------------------------------------------------------
# Mode 2 — Local Ollama mode
# Uncomment/use these values in server/.env for real local RAG + BONA:
# AI_GENERATION_PROVIDER=ollama
# AI_EMBEDDING_PROVIDER=ollama
# SENTINEL_EMBEDDING_DIM=768
# OLLAMA_HOST=host.docker.internal
# OLLAMA_PORT=11434
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_PREDICT=700
# ---------------------------------------------------------------------------
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=700

# 768 for Ollama/nomic-embed-text; 3072 for Gemini/gemini-embedding-2.
# Changing embedding provider requires knowledge-base re-ingestion.
SENTINEL_EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# Mode 3 — Optional Gemini cloud mode
# AI_GENERATION_PROVIDER=gemini
# AI_EMBEDDING_PROVIDER=gemini
# SENTINEL_EMBEDDING_DIM=3072
# GEMINI_API_KEY=<real key>
# Re-ingest the knowledge base after switching the embedding provider.
# ---------------------------------------------------------------------------
